{
  "agentPushNotifEnabled": true,
  "effortLevel": "high",
  "enabledPlugins": {
    "frontend-design@claude-plugins-official": true,
    "merged-branch-cleanup@llm-plugins": true,
    "secret-scan-before-push@llm-plugins": true,
    "superpowers@claude-plugins-official": true,
    "third-party-review@llm-plugins": true
  },
  "extraKnownMarketplaces": {
    "llm-plugins": {
      "source": {
        "repo": "karia/llm-plugins",
        "source": "github"
      }
    }
  },
  "feedbackSurveyState": {
    "lastShownTime": 1754061737663
  },
  "hooks": {
    "Notification": [
      {
        "hooks": [
          {
            "command": "if [[ \"$(uname)\" == \"Darwin\" ]]; then afplay -v 0.8 ~/Documents/icq_System.wav; fi",
            "type": "command"
          }
        ],
        "matcher": ""
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "bash '/home/karia/.claude/hooks/herdr-agent-state.sh' session",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": "*"
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "command": "if [[ \"$(uname)\" == \"Darwin\" ]]; then afplay -v 0.8 ~/Documents/icq_Message.wav; fi",
            "type": "command"
          }
        ],
        "matcher": ""
      }
    ]
  },
  "inputNeededNotifEnabled": true,
  "model": "claude-opus-5",
  "permissions": {
    "allow": [
      "Bash(actionlint:*)",
      "Bash(brew list:*)",
      "Bash(bundle exec rspec:*)",
      "Bash(bundle exec rubocop:*)",
      "Bash(bundle info:*)",
      "Bash(bundle show:*)",
      "Bash(cat:*)",
      "Bash(cd:*)",
      "Bash(command -v:*)",
      "Bash(echo:*)",
      "Bash(gh api:*)",
      "Bash(gh issue create:*)",
      "Bash(gh issue list:*)",
      "Bash(gh issue view:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh pr create:*)",
      "Bash(gh pr diff:*)",
      "Bash(gh pr edit:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr ready:*)",
      "Bash(gh pr view:*)",
      "Bash(gh run list:*)",
      "Bash(gh run view:*)",
      "Bash(git add:*)",
      "Bash(git check-ignore:*)",
      "Bash(git checkout:*)",
      "Bash(git commit:*)",
      "Bash(git fetch:*)",
      "Bash(git log:*)",
      "Bash(git pull:*)",
      "Bash(git push:*)",
      "Bash(git rebase:*)",
      "Bash(git rev-parse:*)",
      "Bash(git worktree:*)",
      "Bash(grep:*)",
      "Bash(hadolint:*)",
      "Bash(jq:*)",
      "Bash(ls:*)",
      "Bash(mise list:*)",
      "Bash(mise ls:*)",
      "Bash(mkdir:*)",
      "Bash(open:*)",
      "Bash(pinact:*)",
      "Bash(pre-commit run:*)",
      "Bash(prek run:*)",
      "Bash(pwd)",
      "Bash(shellcheck:*)",
      "Bash(terraform fmt:*)",
      "Bash(terraform validate:*)",
      "Bash(tflint:*)",
      "Bash(trivy:*)",
      "Bash(yamllint:*)"
    ],
    "ask": [
      "Bash(git push --force:*)",
      "Bash(git push --force-with-lease:*)",
      "Bash(git push -f:*)"
    ],
    "defaultMode": "auto",
    "deny": []
  },
  "plansDirectory": "docs/plans",
  "statusLine": {
    "command": "bash ~/.claude/statusline-command.sh",
    "type": "command"
  },
  "theme": "auto"
}
